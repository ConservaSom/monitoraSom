sr <- 16000
set.seed(7)
tt <- seq_len(10 * sr) / sr
x1 <- rnorm(length(tt), 0, 0.02)
x1[(tt >= 1) & (tt < 1.4)] <- x1[(tt >= 1) & (tt < 1.4)] +
  0.6 * sin(2 * pi * 4000 * tt[(tt >= 1) & (tt < 1.4)])
rec1 <- tuneR::normalize(tuneR::Wave(x1, samp.rate = sr, bit = 16), unit = "16")
